  "query": "\n            SELECT\n                id,\n                version_name,\n                version_number,\n                changelog,\n                variant,\n                url,\n                release_time,\n                create_time,\n                update_time\n            FROM version\n            WHERE variant = $1 AND release_time <= $2 ORDER BY release_time DESC LIMIT 1",
