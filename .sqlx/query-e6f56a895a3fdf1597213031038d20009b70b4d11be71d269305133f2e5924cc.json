  "db_name": "PostgreSQL",
  "query": "SELECT u.id as uid, u.username, u.avatar_url, u.bio, u.is_banned, f.create_time as followed_at\n               FROM follows f\n               JOIN users u ON f.followed_id = u.id\n               WHERE f.follower_id = $1 AND f.create_time < $2\n               ORDER BY f.create_time DESC\n               LIMIT $3",
