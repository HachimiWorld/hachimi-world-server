{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                recipient_uid as \"recipient_uid: _\",\n                notification_type,\n                title,\n                body,\n                content_intent,\n                read_time,\n                create_time\n            FROM notifications\n            WHERE recipient_uid = $1\n                AND ($2::uuid IS NULL OR id < $2)\n                AND create_time >= $3\n            ORDER BY id DESC\n            LIMIT $4",
