{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.title, sp.song_id AS \"song_id: SongId\", count(*) AS play_count\n        FROM song_plays sp\n                 JOIN songs s ON sp.song_id = s.id\n        WHERE sp.create_time > $1\n        GROUP BY sp.song_id, s.title\n        ORDER BY play_count DESC\n        LIMIT $2\n    ",
