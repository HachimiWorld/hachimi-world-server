{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                m.id as \"id: _\",\n                m.user_id as \"user_id: _\",\n                m.content,\n                m.images,\n                m.attachments,\n                m.is_hidden,\n                m.like_count,\n                m.delete_time,\n                m.create_time,\n                m.update_time\n            FROM moments m\n            WHERE m.user_id = $1 AND ($2 OR NOT m.is_hidden) AND m.delete_time IS NULL\n                AND ($3::timestamptz IS NULL OR (m.create_time, m.id) < ($3, $4::bigint))\n            ORDER BY m.create_time DESC, m.id DESC\n            LIMIT $5",
