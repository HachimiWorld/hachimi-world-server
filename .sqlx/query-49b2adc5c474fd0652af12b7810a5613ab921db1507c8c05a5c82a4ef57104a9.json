  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                to_address,\n                subject,\n                body,\n                available_time,\n                attempt_count,\n                sent_time,\n                dead_time,\n                last_error,\n                create_time\n            FROM email_outbox\n            WHERE sent_time IS NULL AND dead_time IS NULL AND available_time <= $1\n            ORDER BY available_time, id\n            LIMIT $2",
