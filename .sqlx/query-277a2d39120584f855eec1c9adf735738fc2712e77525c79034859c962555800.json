{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                subject,\n                -- Instances of an older release may still write 0 for null while a deploy rolls out\n                NULLIF(target_id, 0) AS target_id,\n                actor_uid as \"actor_uid: _\",\n                content,\n                content_hash,\n                policy_version,\n                model,\n                answers,\n                error,\n                blocked_by,\n                latency_ms,\n                reused_from,\n                create_time\n            FROM content_checks\n            WHERE actor_uid = $1 ORDER BY create_time DESC, id DESC LIMIT $2",
