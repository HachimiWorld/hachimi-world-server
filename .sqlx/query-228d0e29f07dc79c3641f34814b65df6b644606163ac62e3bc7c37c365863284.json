{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id as \"id: _\",\n                target_type,\n                target_id,\n                user_id as \"user_id: _\",\n                root_id as \"root_id: _\",\n                reply_to_id as \"reply_to_id: _\",\n                reply_to_uid as \"reply_to_uid: _\",\n                content,\n                is_hidden,\n                like_count,\n                visible_reply_count,\n                delete_time,\n                create_time,\n                update_time\n            FROM comments\n            WHERE target_type = $1 AND target_id = $2 AND root_id IS NULL AND (\n                        (NOT is_hidden AND delete_time IS NULL)\n                        OR visible_reply_count > 0\n                    ) ORDER BY like_count DESC, create_time DESC, id DESC LIMIT $3 OFFSET $4",
